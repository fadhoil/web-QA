# Wajib. Password untuk masuk ke app (bebas, buat yang panjang kalau dipublish).
QA_PASSWORD=ganti-ini

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Pakai service_role key (BUKAN anon). Rahasia: jangan commit, jangan taruh di frontend.
SUPABASE_SERVICE_KEY=eyJ...

# Hanya untuk lokal: izinkan tes website di localhost / IP privat. Jangan set di Vercel.
ALLOW_PRIVATE_HOSTS=1
